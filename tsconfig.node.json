{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts",
    "src/core/**/*.ts",
    "src/negotiation/jevPrompts.ts",
    "src/negotiation/jevClient.ts"
  ]
}
